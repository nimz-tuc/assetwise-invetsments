# Copy your existing .env and ADD the lines below that you don't have yet. Never share this file.
PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=goldvault
DB_USER=
DB_PASSWORD=
JWT_SECRET=            # at least 32 random characters (the server refuses to start without it)
JWT_EXPIRES_IN=1h

# --- new for AssetWise ---
CURRENCY=USD
MIN_DEPOSIT=500
MAX_DEPOSIT=50000
MIN_WITHDRAWAL=100
SUPPORT_EMAIL=
# Paystack online payments. Keys: dashboard.paystack.com > Settings > API Keys & Webhooks.
# sk_test_... = test mode (no real money), sk_live_... = real money. NEVER share this key or put it in the website code.
PAYSTACK_SECRET_KEY=
# OPTIONAL. Leave blank while testing through a tunnel: the site then uses whatever address the visitor opened.
# Set it to your real https domain once you deploy.
PUBLIC_URL=

# Where customers send money (shown on the Deposit page). Leave blank until you have them.
USDT_TRC20_ADDRESS=
USDT_ERC20_ADDRESS=
# Only if you open the page from VS Code Live Server instead of http://localhost:5000
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
